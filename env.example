# ============================================================
#  Bot Spot Multicoin Binance - RSI Oversold Reversal (RSI 1h)
#  Salin file ini menjadi .env lalu isi nilainya.
# ============================================================

# ---- Binance API ---------------------------------------------
# Izin API: "Enable Spot & Margin Trading" SAJA. Matikan Withdrawals.
# Sangat disarankan pakai IP whitelist (IP VPS Anda).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ---- Mode ----------------------------------------------------
# true  = simulasi (tidak ada order asli, saldo virtual) -> MULAI DARI SINI
# false = live trading dengan uang asli
DRY_RUN=true
DRY_RUN_BALANCE=1000
PAPER_FEE_PCT=0.1

# ---- Pair (pisahkan dengan koma) -----------------------------
# Format bebas: BNB/USDT atau BNBUSDT
SYMBOLS=BNB/USDT,ETH/USDT,SOL/USDT
QUOTE_ASSET=USDT

# ---- Telegram ------------------------------------------------
# Buat bot lewat @BotFather, lalu ambil chat id (mis. lewat @userinfobot).
# Kirim satu pesan ke bot Anda dulu supaya bot boleh mengirim pesan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Entry: RSI 1 jam ----------------------------------------
# Strategi hanya memakai RSI pada timeframe 1 jam.
# Default: candle 1 jam yang SEDANG BERJALAN (realtime) - close = harga terkini, sinyal
# bisa muncul sebelum candle ditutup, dan bisa batal bila RSI jatuh lagi sebelum close.
RSI_PERIOD=14
RSI_OVERSOLD=18
RSI_TRIGGER=32
# Berapa candle 1h ke belakang RSI boleh pernah < RSI_OVERSOLD sebelum menembus RSI_TRIGGER
ARM_LOOKBACK=12
# true  = hanya candle 1 jam yang sudah tertutup (sinyal lebih jarang, tidak ada whipsaw)
# false = candle berjalan / realtime (default)
SIGNAL_USE_CLOSED=false
# Jeda minimum antar evaluasi RSI per pair (detik) pada mode realtime
EVAL_SECONDS=60

# ---- Ukuran posisi -------------------------------------------
POSITION_PCT=30
MAX_OPEN_POSITIONS=3

# ---- Take profit & stop loss ---------------------------------
# TP = clamp(TP_ATR_MULT x ATR% 1h, TP_MIN_PCT, TP_MAX_PCT).
# TP_MIN_PCT = TP_MAX_PCT membuat TP FIXED (ATR tidak berpengaruh lagi).
TP_MIN_PCT=4.0
TP_MAX_PCT=4.0
TP_ATR_MULT=1.5
SL_PCT=5.0
# true  = (live) TP & SL dipasang sebagai order OCO di Binance, tetap aktif walau bot/VPS mati
# false = bot memantau harga sendiri lalu market sell (hanya jalan selama bot hidup)
# Mode DRY_RUN selalu disimulasikan lewat pemantauan harga
USE_OCO=true

# ---- Cooldown & anti beli beruntun ---------------------------
# Lama pair dibekukan setelah kena stop loss
COOLDOWN_MINUTES=240
# Jeda minimal setelah entry/exit sebelum boleh entry lagi di pair yang sama
REENTRY_LOCKOUT_MINUTES=120
# Setelah trade, RSI 1h harus naik >= level ini dulu sebelum sinyal baru dianggap valid
REARM_LEVEL=50
# Maksimal entry per pair dalam jendela waktu
MAX_ENTRIES_PER_WINDOW=2
ENTRY_WINDOW_HOURS=24

# ---- Lain-lain -----------------------------------------------
LOOP_SECONDS=10
STATE_FILE=state.json
LOG_FILE=bot.log