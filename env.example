# ============================================================
#  Bot Spot Multicoin Binance - RSI Oversold Reversal
#  Salin file ini menjadi .env lalu isi nilainya.
# ============================================================

# ---- Binance API ---------------------------------------------
# Izin API: "Enable Spot & Margin Trading" SAJA. Matikan Withdrawals.
# Sangat disarankan pakai IP whitelist (IP VPS Anda).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ---- Mode ----------------------------------------------------
# true  = simulasi (tidak ada order asli, saldo virtual) -> MULAI DARI SINI
# false = live trading dengan uang asli
DRY_RUN=true
DRY_RUN_BALANCE=1000
PAPER_FEE_PCT=0.1

# ---- Pair (pisahkan dengan koma) -----------------------------
# Format bebas: BNB/USDT atau BNBUSDT
SYMBOLS=BNB/USDT,ETH/USDT,SOL/USDT
QUOTE_ASSET=USDT

# ---- Telegram ------------------------------------------------
# Buat bot lewat @BotFather, lalu ambil chat id (mis. lewat @userinfobot).
# Kirim satu pesan ke bot Anda dulu supaya bot boleh mengirim pesan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Entry: RSI ----------------------------------------------
RSI_PERIOD=14
RSI_4H_MAX=30
RSI_1H_MAX=30
RSI_OVERSOLD=30
RSI_TRIGGER=32
# Berapa candle 15m ke belakang RSI boleh pernah < RSI_OVERSOLD sebelum menembus RSI_TRIGGER
ARM_LOOKBACK=12
# false = RSI 4H/1H memakai candle berjalan (lebih responsif)
# true  = hanya candle yang sudah close (lebih konservatif, sinyal lebih jarang)
CONTEXT_USE_CLOSED=false

# ---- Ukuran posisi -------------------------------------------
POSITION_PCT=30
MAX_OPEN_POSITIONS=3

# ---- Take profit & stop loss ---------------------------------
# TP dinamis = TP_ATR_MULT x ATR% 1H, dibatasi antara TP_MIN_PCT dan TP_MAX_PCT
TP_MIN_PCT=1.0
TP_MAX_PCT=3.0
TP_ATR_MULT=1.5
SL_PCT=2.0

# ---- Cooldown & anti beli beruntun ---------------------------
# Lama pair dibekukan setelah kena stop loss
COOLDOWN_MINUTES=240
# Jeda minimal setelah entry/exit sebelum boleh entry lagi di pair yang sama
REENTRY_LOCKOUT_MINUTES=120
# Setelah trade, RSI 15m harus naik >= level ini dulu sebelum sinyal baru dianggap valid
REARM_LEVEL=50
# Maksimal entry per pair dalam jendela waktu
MAX_ENTRIES_PER_WINDOW=2
ENTRY_WINDOW_HOURS=24

# ---- Lain-lain -----------------------------------------------
LOOP_SECONDS=10
STATE_FILE=state.json
LOG_FILE=bot.log
